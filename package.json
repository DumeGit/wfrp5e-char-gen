{
  "name": "wfrp-character-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run build",
    "check:books": "node scripts/check-books.mjs",
    "build": "npm run check:books && npm run generate:books && node scripts/build-pwa.mjs",
    "test": "node --test tests/*.test.mjs",
    "generate:books": "node scripts/generate-books.mjs",
    "check:generated": "node scripts/generate-books.mjs --check",
    "check:code": "node scripts/check-code.mjs",
    "check:format": "prettier --check \"dist/*.mjs\" \"dist/features/*.mjs\" \"dist/gm/*.mjs\" dist/app.js scripts/check-code.mjs scripts/check-offline.mjs scripts/generate-books.mjs",
    "check:release": "npm run check:books && npm run check:code && npm run check:generated && npm run check:format && npm test && node scripts/check-offline.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "eslint-scope": "^8.4.0",
    "prettier": "^3.6.2"
  }
}
